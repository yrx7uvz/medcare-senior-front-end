# Copie para .env e ajuste. Variáveis EXPO_PUBLIC_* vão embutidas no app: nunca coloque segredos aqui.

# Endereço da API Spring Boot. Use o IP do PC na rede local (o celular precisa enxergá-lo);
# no emulador Android use http://10.0.2.2:8080
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# true = modo demonstração (dados fictícios em memória, sem API). Ao trocar, reinicie com cache limpo (expo start -c).
EXPO_PUBLIC_DEMO=false
