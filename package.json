{
  "name": "medcare-senior-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "web": "expo start --web",
    "start:demo": "cross-env EXPO_PUBLIC_DEMO=true expo start",
    "android:demo": "cross-env EXPO_PUBLIC_DEMO=true expo start --android",
    "web:demo": "cross-env EXPO_PUBLIC_DEMO=true expo start --web",
    "start:dev": "expo start --dev-client",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "typecheck": "tsc --noEmit",
    "check:mocks": "cross-env EXPO_PUBLIC_DEMO=true tsx scripts/check-mocks.ts",
    "check:core": "tsx scripts/check-core.ts",
    "check:permissions": "tsx scripts/check-android-permissions.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "smoke:api": "tsx scripts/smoke-api.ts",
    "smoke": "tsx scripts/smoke-api.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.2.3",
    "@expo-google-fonts/nunito-sans": "^0.2.3",
    "@expo/metro-runtime": "~57.0.17",
    "@hookform/resolvers": "^3.9.1",
    "@noble/hashes": "1.8.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~57.0.30",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-notifications": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.59.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  }
}
